<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dynamic Theme Clock</title>
    <style>
        /* CSS: ডিজাইন */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #2c3e50; /* ডিফল্ট ডার্ক ব্লু থিম */
            color: white;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            transition: background 0.8s ease, color 0.5s ease;
        }
        
        .clock-container {
            text-align: center;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        h1 { font-size: 3rem; margin: 0 0 10px 0; color: #f1c40f; }
        #clock { font-size: 2.8rem; font-weight: bold; font-family: monospace; margin-bottom: 20px; }
        
        /* ড্রপডাউন মেনুর স্টাইল */
        .dropdown {
            position: relative;
            display: inline-block;
        }

        .dropbtn {
            background-color: #e74c3c;
            color: white;
            padding: 12px 24px;
            font-size: 1rem;
            font-weight: bold;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(231, 76, 60, 0.4);
            transition: all 0.3s ease;
        }

        .dropbtn:hover { background-color: #c0392b; transform: translateY(-2px); }

        /* ড্রপডাউন কন্টেন্ট (শুরুতে লুকানো থাকবে) */
        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #ffffff;
            min-width: 160px;
            box-shadow: 0px 8px 16px rgba(0,0,0,0.3);
            border-radius: 8px;
            z-index: 1;
            margin-top: 5px;
            overflow: hidden;
            left: 50%;
            transform: translateX(-50%);
        }

        /* ড্রplayডাউনের ভেতরের বাটনগুলো */
        .dropdown-content button {
            color: #2c3e50;
            padding: 12px 16px;
            text-decoration: none;
            display: block;
            width: 100%;
            border: none;
            background: none;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            text-align: center;
            transition: background 0.2s;
        }

        .dropdown-content button:hover { background-color: #f1f2f6; }

        /* JavaScript দিয়ে এই ক্লাসটি অ্যাড করলে মেনু নিচে নামবে */
        .show { display: block; animation: fadeIn 0.3s ease; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translate(-50%, -10px); }
            to { opacity: 1; transform: translate(-50%, 0); }
        }

        /* বিভিন্ন থিমের ব্যাকগ্রাউন্ড স্টাইল */
        .theme-dark { background-color: #2c3e50; color: white; }
        .theme-light { background-color: #f5f6fa; color: #2c3e50; }
        .theme-light .clock-container { background: rgba(0, 0, 0, 0.05); border: 1px solid rgba(0, 0, 0, 0.1); }
        .theme-purple { background-color: #6c5ce7; color: white; }
        .theme-sunset { background: linear-gradient(135deg, #ea2027, #ee5a24); color: white; }
    </style>
</head>
<body class="theme-dark">

    <div class="clock-container">
        <h1>Hello World!</h1>
        <p>Choose a theme from the dropdown menu.</p>
        <div id="clock">00:00:00 PM</div>
        
        <div class="dropdown">
            <button onclick="toggleDropdown()" class="dropbtn">Change Theme ▾</button>
            <div id="myDropdown" class="dropdown-content">
                <button onclick="changeTheme('theme-dark')">🌌 Dark Blue</button>
                <button onclick="changeTheme('theme-light')">☀️ Pure Light</button>
                <button onclick="changeTheme('theme-purple')">🔮 Neon Purple</button>
                <button onclick="changeTheme('theme-sunset')">🌅 Sunset Glow</button>
            </div>
        </div>
    </div>

    <script>
        // ১. লাইভ ঘড়ি সচল রাখার কোড
        function updateClock() {
            const now = new Date();
            document.getElementById('clock').innerText = now.toLocaleTimeString();
        }
        setInterval(updateClock, 1000);
        updateClock();

        // ২. ড্রপডাউন মেনু ওপেন/ক্লোজ (Drop down) করার ফাংশন
        function toggleDropdown() {
            document.getElementById("myDropdown").classList.toggle("show");
        }

        // ৩. থিম পরিবর্তন করার ফাংশন
        function changeTheme(themeName) {
            // আগের সব থিম ক্লাস রিমুভ করা হচ্ছে
            document.body.className = '';
            // নতুন সিলেক্ট করা থিম ক্লাস যোগ করা হচ্ছে
            document.body.classList.add(themeName);
            // থিম পরিবর্তনের পর ড্রপডাউনটি বন্ধ করে দেওয়া হচ্ছে
            document.getElementById("myDropdown").classList.remove("show");
        }

        // ওয়েবসাইটের অন্য কোথাও ক্লিক করলে যেন ড্রপডাউন বন্ধ হয়ে যায়
        window.onclick = function(event) {
            if (!event.target.matches('.dropbtn')) {
                var dropdowns = document.getElementsByClassName("dropdown-content");
                for (var i = 0; i < dropdowns.length; i++) {
                    var openDropdown = dropdowns[i];
                    if (openDropdown.classList.contains('show')) {
                        openDropdown.classList.remove('show');
                    }
                }
            }
        }
    </script>
</body>
</html>
